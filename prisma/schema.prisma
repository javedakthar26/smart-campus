generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & Roles ───────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String // ADMIN | TEACHER | STUDENT | PARENT
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  student      Student?
  teacher      Teacher?
  parent       Parent?
  chatMessages ChatMessage[]
}

// ─────────────────────────── Profiles ───────────────────────────

model Student {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo      String       @unique
  classId     String?
  class       Class?       @relation(fields: [classId], references: [id])
  dob         String?
  gender      String?
  phone       String?
  address     String?
  bio         String?
  parentId    String?
  parent      Parent?      @relation(fields: [parentId], references: [id])
  enrollments Enrollment[]
  attendance  Attendance[]
  marks       Mark[]
  reportCards ReportCard[]
  studyPlans  StudyPlan[]
}

model Parent {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation String    @default("Guardian")
  phone    String?
  children Student[]
}

model Teacher {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  phone   String?
  classes Class[]
}

// ─────────────────────────── Academics ───────────────────────────

model Class {
  id          String       @id @default(cuid())
  name        String       @unique
  room        String?
  teacherId   String?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  students    Student[]
  subjects    Subject[]
  enrollments Enrollment[]
  attendance  Attendance[]
}

model Subject {
  id      String @id @default(cuid())
  name    String
  code    String
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([code, classId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED | WITHDRAWN
  createdAt DateTime @default(now())

  @@unique([studentId, classId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  status    String // PRESENT | ABSENT | LATE | LEAVE
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, classId, date])
}

model Mark {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exam      String // e.g. "Midterm", "Term 1 Exam", "Final Exam"
  score     Float
  maxScore  Float    @default(100)
  createdAt DateTime @default(now())

  @@unique([studentId, subjectId, exam])
}

// ─────────────────────────── AI Artifacts ───────────────────────────

model ReportCard {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam      String
  percentage Float
  grade     String
  gpa       Float
  remarks   String
  createdAt DateTime @default(now())

  @@unique([studentId, exam])
}

model StudyPlan {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  goal      String
  content   String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}
